{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cat-sticker-sheet plan",
  "_protocol": "[INPUT]: 依赖 subject-identity.md 的身份锚点、one-step-concepts.md 的单步错位和 style-system.md 的 9+6 契约; [OUTPUT]: 对外提供一页贴纸的最小内容 JSON，被 validate_plan.py 与 compile_prompt.py 消费; [POS]: references 的内容契约层，只保存实现画面所需变量; [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md",
  "type": "object",
  "required": ["subject", "page", "pieces", "accents"],
  "additionalProperties": false,
  "properties": {
    "subject": {
      "type": "object",
      "required": ["breed_or_type", "must_preserve"],
      "additionalProperties": false,
      "properties": {
        "breed_or_type": {
          "type": "string",
          "minLength": 1
        },
        "must_preserve": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "page": {
      "type": "object",
      "required": ["background", "palette", "text"],
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "每页独立的背景艺术方向，可为颜色、渐变、纸张质感、柔光或低对比图形；不设固定默认色，并与白色描边保持可见对比"
        },
        "palette": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "text": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pieces": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": [
          "n",
          "scale",
          "presentation",
          "human_action",
          "object",
          "cat_interaction",
          "single_displacement",
          "expression",
          "color",
          "absurdity_level"
        ],
        "additionalProperties": false,
        "properties": {
          "n": { "type": "integer", "minimum": 1, "maximum": 9 },
          "scale": { "enum": ["hero", "medium", "small"] },
          "presentation": { "enum": ["wears", "operates", "face_in_cover"] },
          "human_action": { "type": "string", "minLength": 1, "maxLength": 120 },
          "object": { "type": "string", "minLength": 1, "maxLength": 80 },
          "cat_interaction": { "type": "string", "minLength": 1, "maxLength": 160 },
          "single_displacement": { "type": "string", "minLength": 1, "maxLength": 160 },
          "expression": { "type": "string", "minLength": 1, "maxLength": 80 },
          "color": { "type": "string", "minLength": 1, "maxLength": 80 },
          "absurdity_level": { "type": "integer", "enum": [1, 2] }
        }
      }
    },
    "accents": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "motif": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        },
        "oneOf": [
          { "required": ["motif"] },
          { "required": ["text"] }
        ]
      }
    }
  }
}
